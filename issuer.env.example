# /etc/wazuh-cert-issuer/issuer.env   (chmod 640, root:wazuh-issuer)

# --- CA material (stays on this host, never leaves) ---
CA_DIR=/opt/wazuh-ca
CA_KEY=/opt/wazuh-ca/agents-rootCA.key
CA_CERT=/opt/wazuh-ca/agents-rootCA.pem
ISSUE_SCRIPT=/opt/wazuh-ca/issue_agent_cert.sh

# Short lifetime is your revocation mechanism. openssl x509 -req signing
# produces no CRL and no OCSP, so a leaked agent cert cannot be revoked --
# it can only be allowed to expire. 2 days is plenty: the cert is used once,
# at enrollment, and then deleted from the endpoint.
CERT_DAYS=2

# --- auth: token | mtls | either ---
AUTH_MODE=token
TOKEN_SECRET_FILE=/etc/wazuh-cert-issuer/token.secret
# Intune MDM device certs carry the Entra device ID as CN (a GUID).
MTLS_CN_ALLOW_RE=^[0-9a-fA-F-]{36}$

# --- what agents get told ---
MANAGER_ADDRESS=192.168.29.192
DEFAULT_GROUP_WIN=windows-agents
DEFAULT_GROUP_LINUX=linux-agents

# --- S3 (issuer reads; agents never touch AWS) ---
S3_BUCKET=acme-wazuh-bootstrap
S3_KEY_MANAGER_CA=manager/agents-rootCA.pem
S3_KEY_ENROLL_PW=manager/enrollment-password.txt
S3_CACHE_TTL=300
AWS_REGION=eu-central-1
# Prefer an instance role / IRSA. Static keys here only if you have no choice:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- policy ---
DB_PATH=/var/lib/wazuh-cert-issuer/issuance.db
REISSUE_COOLDOWN=600
