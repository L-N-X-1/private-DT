# /etc/wazuh-bootstrap/bootstrap.conf   (chmod 644, root:root)
#
# Nothing in this file is a secret.
#
# ISSUER_URL is an RFC 1918 address, and ISSUER_PINS is the public-key
# fingerprint of a public certificate. There is deliberately no
# BOOTSTRAP_TOKEN: tokens are single-use, minted per machine, and passed
# to wazuh_bootstrap.sh on stdin so they never touch this host's disk.
#
# wazuh_bootstrap.sh will refuse to run if BOOTSTRAP_TOKEN is set here.

ISSUER_URL="https://192.168.29.192:8443"

# SPKI pin of issuer.crt ONLY -- not agents-rootCA.
#
#   openssl x509 -in /etc/wazuh-cert-issuer/tls/issuer.crt -pubkey -noout |
#     openssl pkey -pubin -outform der | openssl dgst -sha256 -binary |
#     openssl enc -base64
#
# Rotate this when issuer.crt is reissued (825 days from Phase 3.3).
ISSUER_PINS="sha256//gRuuyWVIpGmv9mhvOm+zRn2XEU5146OYZVJDlCYLJlA="

# Fallbacks only. The issuer's response wins if it pinned a name or group
# to the token.
AGENT_GROUP="linux-agents"
# AGENT_NAME defaults to $(hostname); uncomment to override.
# AGENT_NAME="FIN-SRV-01"

# wazuh-agent package version. Keep this equal to the manager version --
# an agent newer than its manager is unsupported. The install is pinned
# (apt-mark hold / dnf versionlock) so a later system update cannot drift
# past it; release the hold deliberately when you upgrade the manager.
AGENT_VERSION="4.14.3"

# Install the daily audit-config drift enforcement timer.
# Default 1. Set to 0 only where auditd rules are managed by Ansible/Puppet or
# a CIS hardening baseline -- two things rewriting /etc/audit/rules.d/ will
# fight each other, and the loser is whichever ran first.
AUDIT_TIMER=1